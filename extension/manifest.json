{
  "manifest_version": 3,
  "name": "Document Zoom for Google Drive",
  "short_name": "Doc Zoom",
  "version": "1.0.0",
  "description": "Zoom Google Docs, Sheets, Slides and Drive previews with Ctrl+Alt+scroll, without zooming the toolbars or the whole page.",
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/*",
        "https://drive.google.com/*"
      ],
      "js": [
        "defaults.js",
        "settings-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://docs.google.com/*",
        "https://drive.google.com/*"
      ],
      "js": [
        "zoom.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
